a:["$","$L3e",null,{"textProps":{"fontFamily":"sans","fontSize":"small","fontStyle":"normal","fontWeight":"normal","lineHeight":"default","textAlign":"start","children":[[["$","$3f","0",{"children":[null,"Arthur is an 𝐞𝐱𝐞𝐜𝐮𝐭𝐢𝐯𝐞 𝐥𝐞𝐚𝐝𝐞𝐫 𝐢𝐧 𝐩𝐚𝐲𝐦𝐞𝐧𝐭𝐬 𝐚𝐧𝐝 𝐟𝐢𝐧𝐚𝐧𝐜𝐢𝐚𝐥 𝐭𝐞𝐜𝐡𝐧𝐨𝐥𝐨𝐠𝐲, operating at the intersection of global commerce, digital infrastructure, and next-generation payment innovation."]}],["$","$3f","1",{"children":[["$","br",null,{}],""]}],["$","$3f","2",{"children":[["$","br",null,{}],"Founder of Monyz: A new venture helping FinTechs go viral and turn that attention into revenue."]}],["$","$3f","3",{"children":[["$","br",null,{}],""]}],["$","$3f","4",{"children":[["$","br",null,{}],"Arthur co-founded 𝐂𝐨𝐧𝐧𝐞𝐜𝐭𝐢𝐧𝐠 𝐭𝐡𝐞 𝐃𝐨𝐭𝐬 𝐢𝐧 𝐏𝐚𝐲𝐦𝐞𝐧𝐭𝐬, the industry’s largest media and insights platform, followed by 100,000+ leaders across fintech, banking, issuing, acquiring, and merchant ecosystems. The platform provides unmatched clarity on the trends reshaping global payments."]}],["$","$3f","5",{"children":[["$","br",null,{}],""]}],["$","$3f","6",{"children":[["$","br",null,{}],"Arthur also serves as a 𝐒𝐭𝐫𝐚𝐭𝐞𝐠𝐢𝐜 𝐀𝐝𝐯𝐢𝐬𝐨𝐫 𝐭𝐨 𝐡𝐢𝐠𝐡-𝐠𝐫𝐨𝐰𝐭𝐡 𝐜𝐨𝐦𝐩𝐚𝐧𝐢𝐞𝐬 𝐦𝐨𝐝𝐞𝐫𝐧𝐢𝐳𝐢𝐧𝐠 𝐟𝐢𝐧𝐚𝐧𝐜𝐢𝐚𝐥 𝐢𝐧𝐬𝐭𝐢𝐭𝐮𝐭𝐢𝐨𝐧𝐬 — guiding GTM strategy, product-market fit, and enterprise adoption across payments, tokenization, digital assets, and AI-driven commerce."]}],["$","$3f","7",{"children":[["$","br",null,{}],""]}],["$","$3f","8",{"children":[["$","br",null,{}],"Arthur holds 2 Master's Degrees, MSc in Business Analytics & MSc in International Business (Hult International Business School) and a BBA from Texas A&M University–Corpus Christi, where he competed as an NCAA Division I athlete. He is fluent in English, French, Spanish, and Italian"]}]]],"linkColorTokens":"$undefined","linkHoverDecoration":"underline","lineClamp":3,"hasShowMore":false,"expandButtonText":"more","shouldCollapseNewLines":false,"noopOverride":false},"bindingKey":{"key":{"value":{"$case":"id","id":"expandable_text_block_auto-component-d0aab5fd-bae6-423d-b